---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada · Sâmela Laura">
  <main class="nf">
    <p class="eyebrow">Erro 404</p>
    <h1 class="display">Essa página não existe.</h1>
    <a href="/" class="btn btn-primary">Voltar para o início</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: var(--gutter);
    text-align: center;
  }
  h1 {
    font-size: clamp(40px, 6vw, 72px);
  }
</style>
