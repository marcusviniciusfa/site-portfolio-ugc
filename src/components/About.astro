---
import { Image } from 'astro:assets';
import portrait from '../assets/1.jpg';
import { niches } from '../config/site';
---

<section id="sobre" class="about section">
  <div class="container inner">
    <p class="eyebrow mobile-only">03 — Sobre mim</p>
    <Image
      src={portrait}
      alt="Retrato da Sâmela Laura"
      widths={[400, 600, 800, 1000]}
      sizes="(max-width: 900px) 100vw, 500px"
      class="portrait"
    />
    <div class="text">
      <p class="eyebrow desktop-only">03 — Sobre mim</p>
      <h2 class="display">Oi, eu sou a Sâmela.</h2>
      <p class="bio">
        A minha casa é o meu estúdio, e a minha família, o meu elenco. Quando a vida pediu um recomeço, transformei a
        minha rotina em conteúdo para marcas. Hoje gravo vídeos sinceros e acolhedores, que mostram o produto funcionando
        no dia a dia de quem usa.
      </p>
      <div class="niches">
        <p class="eyebrow muted">Nichos</p>
        <ul class="tags">
          {niches.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    align-items: center;
    gap: clamp(40px, 6.7vw, 96px);
  }

  .portrait {
    flex-shrink: 0;
    width: 500px;
    height: 640px;
    object-fit: cover;
    border-radius: 250px 250px 24px 24px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  h2 {
    font-size: clamp(38px, 5vw, 72px);
  }

  .bio {
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.66;
  }

  .niches {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .muted {
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tags li {
    background: var(--sand);
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 900px) {
    .inner {
      flex-direction: column;
      align-items: stretch;
      gap: 22px;
    }
    .portrait {
      width: 100%;
      height: 420px;
      border-radius: 200px 200px 16px 16px;
    }
    .text {
      gap: 22px;
    }
    .tags {
      gap: 8px;
    }
    .mobile-only {
      display: block;
    }
    .desktop-only {
      display: none;
    }
  }
</style>
