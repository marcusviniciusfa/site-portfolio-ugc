---
import { Mail, ChevronDown } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { site, contactRoutes, contentTypes } from '../config/site';
---

<section id="contato" class="contact section">
  <div class="container inner">
    <div class="left">
      <p class="eyebrow">06 — Contato</p>
      <h2 class="display">Vamos criar juntos?</h2>
      <p class="note" aria-hidden="true">respondo com carinho</p>
      <p class="lead">Orçamento sem compromisso</p>
      <p class="desc">Me conte sobre a sua marca e o produto que você quer mostrar. Envio uma proposta sob medida.</p>
      <ul class="channels">
        <li>
          <a href={contactRoutes.email}><Mail size={18} aria-hidden="true" /> Enviar um e-mail</a>
        </li>
        <li>
          <a href={site.instagram.url} target="_blank" rel="noopener"><BrandIcon name="instagram" /> {site.instagram.handle}</a>
        </li>
        <li>
          <a href={contactRoutes.whatsapp} target="_blank" rel="noopener"><BrandIcon name="whatsapp" /> WhatsApp</a>
        </li>
      </ul>
    </div>

    <form class="form" method="post" action={contactRoutes.form} data-form novalidate>
      <label class="field">
        <span>Nome</span>
        <input name="nome" type="text" placeholder="Seu nome" autocomplete="name" required maxlength="120" />
      </label>
      <label class="field">
        <span>Marca</span>
        <input name="marca" type="text" placeholder="Nome da marca" autocomplete="organization" maxlength="120" />
      </label>
      <label class="field">
        <span>E-mail</span>
        <input name="email" type="email" placeholder="voce@marca.com.br" autocomplete="email" required maxlength="200" />
      </label>
      <label class="field">
        <span>Tipo de conteúdo</span>
        <span class="select">
          <select name="tipo">
            {contentTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
          <ChevronDown size={18} aria-hidden="true" />
        </span>
      </label>
      <label class="field">
        <span>Mensagem</span>
        <textarea name="mensagem" rows="4" placeholder="Ex.: lançamento de produto, 3 vídeos para anúncio" required maxlength="4000"></textarea>
      </label>

      <!-- Honeypot anti-spam: humanos não veem este campo. -->
      <label class="hp" aria-hidden="true">
        Não preencha
        <input name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>

      <button class="btn btn-primary submit" type="submit">Enviar pedido de orçamento</button>
      <p class="status" role="status" aria-live="polite" data-status></p>

      <a href={contactRoutes.whatsapp} target="_blank" rel="noopener" class="wa">
        <BrandIcon name="whatsapp" size={20} /> Prefere WhatsApp? Me chama aqui
      </a>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--brown);
    color: var(--white);
  }

  .inner {
    display: flex;
    align-items: flex-start;
    gap: clamp(40px, 6.7vw, 96px);
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 460px;
    flex-shrink: 0;
  }

  .eyebrow {
    color: var(--sky);
  }

  h2 {
    font-size: clamp(52px, 5.8vw, 84px);
  }

  .note {
    margin-top: -8px;
    font-family: var(--hand);
    font-size: 34px;
    font-weight: 600;
    color: var(--caramel);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .lead {
    font-size: 20px;
    color: #e9dcd0;
  }

  .desc {
    font-size: 16px;
    color: #cdbbae;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    font-size: 15px;
  }

  .channels a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .channels a:hover {
    text-decoration: underline;
  }

  .form {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--bg);
    color: var(--brown);
    border-radius: 20px;
    padding: clamp(24px, 2.8vw, 40px);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field > span:first-child {
    font-size: 12px;
    font-weight: 600;
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    color: var(--brown);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.2s;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--placeholder);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--terra);
    box-shadow: 0 0 0 3px rgb(168 106 85 / 0.15);
  }

  textarea {
    resize: vertical;
    min-height: 110px;
  }

  .select {
    position: relative;
    display: block;
  }

  select {
    appearance: none;
    padding-right: 40px;
    cursor: pointer;
  }

  .select :global(svg) {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--muted);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    width: 100%;
    padding: 16px 22px;
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status {
    min-height: 0;
    font-size: 14px;
    text-align: center;
  }

  .status:empty {
    display: none;
  }

  .status[data-kind='error'] {
    color: #b3412e;
  }

  .status[data-kind='ok'] {
    color: #3f7a4f;
  }

  .wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 50px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--terra-deep);
    color: var(--terra-deep);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .wa:hover {
    background: rgb(148 89 74 / 0.08);
  }

  @media (max-width: 900px) {
    .inner {
      flex-direction: column;
      align-items: stretch;
    }
    .left {
      width: auto;
      gap: 18px;
    }
    .channels {
      padding-top: 8px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function show(kind: 'ok' | 'error', text: string) {
    if (!status) return;
    status.dataset.kind = kind;
    status.textContent = text;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    button!.disabled = true;
    show('ok', 'Enviando…');
    try {
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('ok', 'Pedido enviado! Respondo em breve.');
    } catch {
      show('error', 'Não consegui enviar agora. Tente de novo ou me chame no WhatsApp.');
    } finally {
      button!.disabled = false;
    }
  });
</script>
